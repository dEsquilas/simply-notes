APP_NAME="Simply Notes"
APP_ENV=local
APP_KEY=simply-notes-testing-key-32bytes
APP_DEBUG=true
APP_URL=http://127.0.0.1:8123

LOG_CHANNEL=single
LOG_LEVEL=debug

# Browser tests use their own SQLite file, never a real database
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# The browser and the test runner are different processes: sessions must live on disk
SESSION_DRIVER=file
MAIL_MAILER=array

RAY_ENABLED=false

GOOGLE_CLIENT_ID=dusk
GOOGLE_CLIENT_SECRET=dusk
GOOGLE_REDIRECT_URL=http://127.0.0.1:8123/google/callback
