APP_NAME="Simply Notes"
APP_ENV=testing
APP_KEY=simply-notes-testing-key-32bytes
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Tests must never touch a real database
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

GOOGLE_CLIENT_ID=testing
GOOGLE_CLIENT_SECRET=testing
GOOGLE_REDIRECT_URL=http://localhost/google/callback
